# =============================================================================
# Alexa Business Autopilot — Backend Environment Configuration Example
# Copy this file to .env and supply your credentials. NEVER commit .env to Git.
# =============================================================================

# Google Gemini Developer API Configuration
# Sign up and retrieve key from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Storage & Persistence Paths
DATABASE_PATH=data/business_autopilot.db
CHROMA_PERSIST_DIR=data/chroma
