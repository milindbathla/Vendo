# =============================================================================
# Alexa Business Autopilot — Backend Environment Configuration Example
# Copy this file to .env and supply your credentials. NEVER commit .env to Git.
# =============================================================================

# Google Gemini Developer API Configuration
# Sign up and retrieve key from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-001

# Storage & Persistence Paths
# Canonical database: the seeded demo.db (teammate-owned domain schema).
# The autopilot's own runtime tables (autopilot_*) are created additively inside it.
DATABASE_PATH=data/demo.db

# -----------------------------------------------------------------------------
# External Integrations Configuration
# -----------------------------------------------------------------------------

# Set to true to force offline mock mode for all external APIs (default: auto-detected if keys missing)
MOCK_INTEGRATIONS=false

# 1. Google Maps Platform: Places API (New)
# Enable "Places API (New)" in Google Cloud Console and obtain an API key.
# Restrict key by API: Places API (New).
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# 2. Zoho Books API & OAuth 2.0
# Register a Zoho Self Client or OAuth App at https://api-console.zoho.com
# Required Scopes: ZohoBooks.organizations.READ, ZohoBooks.invoices.READ, ZohoBooks.bills.READ, ZohoBooks.expenses.READ
ZOHO_CLIENT_ID=your_zoho_client_id_here
ZOHO_CLIENT_SECRET=your_zoho_client_secret_here
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token_here
ZOHO_ORG_ID=your_zoho_organization_id_here
# Accounts URL depends on your Zoho datacenter:
# India: https://accounts.zoho.in (default)
# US: https://accounts.zoho.com
# EU: https://accounts.zoho.eu
# Australia: https://accounts.zoho.com.au
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
# Optional custom API domain override (defaults to domain returned by OAuth or inferred from accounts URL)
# India: https://www.zohoapis.in
# US: https://www.zohoapis.com
ZOHO_API_DOMAIN=https://www.zohoapis.in

# 3. Amazon Pay India (Tier-2 / Hackathon core)
# Register at https://sellercentral.amazon.in → Appstore → Amazon Pay
# Download public/private key pair from the Amazon Pay console.
AMAZON_PAY_PUBLIC_KEY_ID=SANDBOX-XXXXXXXXXXXXXXXXXXXXXXXXXX
AMAZON_PAY_PRIVATE_KEY_PATH=/path/to/AmazonPay.pem
AMAZON_PAY_MERCHANT_ID=XXXXXXXXXXXXXX
# Set to "true" for sandbox (test) mode; flip to "false" for production.
AMAZON_PAY_SANDBOX=true

# 4. Meta / Instagram Graph API (Tier-2 — social engagement & campaign metrics)
# Create an app at https://developers.facebook.com → My Apps → Add App
# Generate a long-lived page / user access token from the Graph API Explorer.
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_ACCESS_TOKEN=your_meta_long_lived_access_token_here

# 5. OAuth Token Encryption (for encrypted per-merchant token store)
# Generate a strong Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED for production; falls back to base64-only in dev if not set.
TOKEN_ENCRYPTION_KEY=your_fernet_encryption_key_here
