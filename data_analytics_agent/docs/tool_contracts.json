              "title": "Period Resolved"
            },
            "latency_ms": {
              "default": 0.0,
              "description": "Execution latency in milliseconds",
              "title": "Latency Ms",
              "type": "number"
            },
            "queries": {
              "default": 1,
              "description": "Number of database queries executed",
              "title": "Queries",
              "type": "integer"
            }
          },
          "required": [
            "tool",
            "as_of"
          ],
          "title": "ToolMeta",
          "type": "object"
        }
      },
      "description": "Standardized response envelope returned by all tools.",
      "properties": {
        "ok": {
          "description": "Whether the tool succeeded",
          "title": "Ok",
          "type": "boolean"
        },
        "data": {
          "additionalProperties": true,
          "description": "Precomputed structured payload including speech_summary",
          "title": "Data",
          "type": "object"
        },
        "confidence": {
          "description": "Calculated confidence score [0.0, 1.0]",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
