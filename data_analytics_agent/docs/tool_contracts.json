  "write_business_memory": {
    "name": "write_business_memory",
    "category": "context",
    "description": "Record an owner statement into business memory. Enforces read-only safety except for memory and audit tables. Detects conflicts with verified records.",
    "parameters": {
      "description": "Input parameters for write_business_memory.",
      "properties": {
        "key": {
          "default": "policy.owner_note",
          "description": "Knowledge topic key (e.g. 'owner.preferred_delivery_time')",
          "title": "Key",
          "type": "string"
        },
        "value": {
          "default": "noted",
          "description": "Value asserted by the owner",
          "title": "Value",
          "type": "string"
        },
        "category": {
          "anyOf": [
