          "type": "array"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Error message if tool failed",
          "title": "Error"
        },
        "meta": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolMeta"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
