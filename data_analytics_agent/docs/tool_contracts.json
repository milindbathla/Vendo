  "get_business_overview": {
    "name": "get_business_overview",
    "category": "context",
    "description": "Owner's morning/evening briefing. Returns cash position, tomorrow's load, shortage risks, customer counts, unread supplier issues, pending ledgers, and memory conflicts.",
    "parameters": {
      "description": "Input parameters for get_business_overview (takes no arguments).",
      "properties": {},
      "title": "GetBusinessOverviewInput",
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "ToolMeta": {
          "description": "Execution metadata attached to tool results.",
          "properties": {
            "tool": {
              "description": "Name of the tool executed",
              "title": "Tool",
              "type": "string"
            },
            "as_of": {
              "description": "Frozen timestamp as of which the query ran",
              "title": "As Of",
              "type": "string"
            },
            "period_resolved": {
