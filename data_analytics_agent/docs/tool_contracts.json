              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional category prefix",
          "title": "Category"
        },
        "source": {
          "default": "owner_statement",
          "description": "Source of the memory. Only 'owner_statement' is accepted by this tool.",
          "enum": [
            "owner_statement",
            "verified_record"
          ],
          "title": "Source",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
